exports[`sidebar shell snapshots > renders the collapsed rail after the crossfade settles, in place 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root collapsed railIn quietBars"
    data-sidebar-rail-collapsed="true"
    style=""
  >
    <div
      class="logoRow"
    >
      <button
        class="brandGlyph"
        type="button"
      >
        <span
          aria-hidden="true"
        >
          <div
            data-slot="sidebar.brand.glyph"
            style="display: contents;"
          >
            <svg
              aria-hidden="true"
              data-content="194bb109"
              fill="none"
              height="22"
              viewBox="0 0 24 24"
              width="22"
            />
          </div>
        </span>
        <span
          class="visuallyHidden"
        >
          <div
            data-slot="sidebar.brand.short-name"
            style="display: contents;"
          >
            Workbench
          </div>
        </span>
      </button>
    </div>
    <div
      class="railControls"
    >
      <button
        aria-label="Open sidebar"
        class="iconButton railControl"
        type="button"
      >
        <svg
          data-content="35f95b0c"
          fill="none"
          height="18"
          viewBox="0 0 16 16"
          width="18"
          xmlns="http://www.w3.org/2000/svg"
        />
      </button>
    </div>
    <button
      aria-label="New session"
      class="newSession"
      type="button"
    >
      <svg
        data-content="c0ce4dcc"
        fill="none"
        height="18"
        viewBox="0 0 16 16"
        width="18"
        xmlns="http://www.w3.org/2000/svg"
      />
    </button>
    <div
      class="homeNavigation"
    >
      <nav
        aria-label="AI Workspace navigation"
        class="aiWorkspace aiWorkspaceRail"
      >
        <ul
          class="aiWorkspaceList"
        >
          <li
            class="workspaceEntry"
          >
            <button
              aria-label="Command"
              aria-pressed="true"
              class="workspaceButton workspaceButtonActive"
              data-workspace="command"
              type="button"
            >
              <span
                aria-hidden="true"
                class="avatar command compact"
                data-compact="true"
                data-mascot-shape="blob"
                data-state="idle"
                data-workspace-identity="command"
              >
                <span
                  class="mark"
                />
                <span
                  class="status"
                />
              </span>
            </button>
          </li>
          <li
            class="workspaceEntry"
          >
            <button
              aria-label="Projects"
              aria-pressed="false"
              class="workspaceButton"
              data-workspace="projects"
              type="button"
            >
              <span
                aria-hidden="true"
                class="avatar projects compact"
                data-compact="true"
                data-mascot-shape="capsule"
                data-state="idle"
                data-workspace-identity="projects"
              >
                <span
                  class="mark"
                />
                <span
                  class="status"
                />
              </span>
            </button>
          </li>
          <li
            class="workspaceEntry"
          >
            <button
              aria-label="Work"
              aria-pressed="false"
              class="workspaceButton"
              data-workspace="work"
              type="button"
            >
              <span
                aria-hidden="true"
                class="avatar work compact"
                data-compact="true"
                data-mascot-shape="crystal"
                data-state="idle"
                data-workspace-identity="work"
              >
                <span
                  class="mark"
                />
                <span
                  class="status"
                />
              </span>
            </button>
          </li>
          <li
            class="workspaceEntry"
          >
            <button
              aria-label="Studios"
              aria-pressed="false"
              class="workspaceButton"
              data-workspace="studios"
              type="button"
            >
              <span
                aria-hidden="true"
                class="avatar studios compact"
                data-compact="true"
                data-mascot-shape="wedge"
                data-state="idle"
                data-workspace-identity="studios"
              >
                <span
                  class="mark"
                />
                <span
                  class="status"
                />
              </span>
            </button>
          </li>
          <li
            class="workspaceEntry"
          >
            <button
              aria-label="Radar"
              aria-pressed="false"
              class="workspaceButton"
              data-workspace="radar"
              type="button"
            >
              <span
                aria-hidden="true"
                class="avatar radar compact"
                data-compact="true"
                data-mascot-shape="cloud"
                data-state="idle"
                data-workspace-identity="radar"
              >
                <span
                  class="mark"
                />
                <span
                  class="status"
                />
              </span>
            </button>
          </li>
        </ul>
      </nav>
    </div>
    <div
      class="footArea"
    >
      <div
        class="libraryArea"
      >
        <button
          aria-controls="sidebar-library-placeholder"
          aria-expanded="false"
          aria-label="Library"
          class="libraryButton"
          type="button"
        >
          <svg
            data-content="7d0b657c"
            fill="none"
            height="18"
            viewBox="0 0 16 16"
            width="18"
          />
        </button>
      </div>
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        aria-label="System status and updates"
        class="systemStatusSeat"
        data-sidebar-system-status-seat=""
        title="System status and updates"
      />
      <div
        class="settingsArea"
      >
        <div
          data-slot="sidebar.settings"
          style="display: contents;"
        />
      </div>
      <div
        aria-hidden="false"
        class="voiceSeat"
        data-sidebar-voice-seat=""
      />
    </div>
  </div>
</div>
`;

exports[`sidebar shell snapshots > renders the expanded column (wordmark, capsule, empty holes) 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root quietBars"
